^.*\.Rproj$
^\.Rproj\.user$
^\.github$
^_targets\.R$
^_targets$
^\.DS_Store$
^random_walk\.md$
^R/setup$
^R/plans$
^check_output\.log$
^default\.nix$
^_pkgdown\.yml$
^docs$
^pkgdown$
^archive$
^CLAUDE_CONTEXT\.md$
^PROJECT_INFO\.md$
^push_to_cachix\.sh$
^.*\.sh$
^rix_minimal\.nix$
^default-ci\.nix$
^default-dev\.nix$
^default\.R$
^package\.nix$
^random_walk\.code-workspace$
^ISSUES_GROUPED_BY_DIFFICULTY\.md$
^ISSUES_GROUPED\.md$
^STARTUP\.md$
^result$
^result/$
^shinylive-sw\.js$
^benchmarks$
^benchmarks/$
^_extensions$
^_extensions/
^_quarto\.yml$

# Exclude entire vignettes/ directory from package
# Vignettes have long file paths and work better on website (docs/articles/)
^vignettes/

# Ignore other hidden files/directories found by R CMD check at top level
^\.cachix_test$
^\.envrc_old$
^\.claude$
^\.claude/
^\.quarto$
^\.quarto/

# Specific ignore for shinylive/webr compiled objects and related files
^vignettes/.*/libs/quarto-contrib/shinylive-0.9.1/shinylive/webr/.*$

# Non-standard top-level documentation files (exclude from package)
^AGENTS\.md$
^CONSOLIDATION_.*\.md$
^PLAN_.*\.md$
^local_checks\.log$
^WIKI_.*\.md$
^.*_EXAMPLES\.md$
^DEVTOOLS_LOAD_ALL_EXAMPLES\.md$
^GC_ROOT_EXAMPLES\.md$
^TIPS\.txt$
