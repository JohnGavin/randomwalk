#!/bin/bash
# pre-commit hook - Regenerate nix files when DESCRIPTION changes
#
# This hook ensures that nix files (package.nix, default-ci.nix, default.nix)
# are always in sync with DESCRIPTION by automatically regenerating them
# when DESCRIPTION is modified.
#
# Generated by: Fix #78 - Automate nix file regeneration
# Installation: This file should be executable and located at .git/hooks/pre-commit

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if DESCRIPTION file is being committed
if git diff --cached --name-only | grep -q '^DESCRIPTION$'; then
  echo -e "${YELLOW}🔍 DESCRIPTION changed - regenerating nix files...${NC}"

  # Run the nix generation script
  if Rscript -e "source('R/setup/generate_nix_files.R'); generate_all_nix_files(verify = FALSE)" 2>&1 | tee /tmp/nix_gen.log; then
    echo -e "${GREEN}✅ Nix files regenerated successfully${NC}"

    # Stage the updated nix files
    git add package.nix default-ci.nix default.nix
    echo -e "${GREEN}✅ Updated nix files staged for commit${NC}"

    # Show what was regenerated
    echo ""
    echo "📋 Regenerated files:"
    git diff --cached --stat | grep -E '(package\.nix|default-ci\.nix|default\.nix)' || echo "  (no changes detected)"
    echo ""

    # Success message
    echo -e "${GREEN}✅ Pre-commit hook complete${NC}"
    echo ""

  else
    # Generation failed
    echo -e "${RED}❌ ERROR: Nix file generation failed!${NC}"
    echo ""
    echo "Log output:"
    cat /tmp/nix_gen.log
    echo ""
    echo -e "${RED}Commit aborted. Please fix the errors and try again.${NC}"
    echo ""
    exit 1
  fi
fi

# Allow commit to proceed
exit 0
