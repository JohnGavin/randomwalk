^.*\.Rproj$
^\.Rproj\.user$
^\.github$
^_targets\.R$
^_targets$
^\.DS_Store$
^random_walk\.md$
^R/setup$
^R/plans$
^check_output\.log$
^default\.nix$
^_pkgdown\.yml$
^docs$
^pkgdown$
^archive$
^CLAUDE_CONTEXT\.md$
^PROJECT_INFO\.md$
^push_to_cachix\.sh$
^.*\.sh$
^rix_minimal\.nix$
^default-ci\.nix$
^default-dev\.nix$
^default\.R$
^package\.nix$
^random_walk\.code-workspace$
^ISSUES_GROUPED_BY_DIFFICULTY\.md$
^ISSUES_GROUPED\.md$
^STARTUP\.md$
^result$
^result/$
^benchmarks$
^benchmarks/$
^_extensions$
^_extensions/
^_quarto\.yml$

# Ignore other hidden files/directories found by R CMD check at top level
^\.cachix_test$
^\.envrc_old$
^\.claude$
^\.claude/
^\.quarto$
^\.quarto/

# Exclude vignette build artifacts (keep source .qmd files)
^vignettes/.*\.html$
^vignettes/.*_files/
^vignettes/_targets\.yaml$
^vignettes/\.quarto$

# Exclude disabled vignettes (Issue #132)
^vignettes/.*\.qmd\.disabled$
^vignettes/.*\.qmd\.bak$
^vignettes/README_DISABLED\.md$

# Non-standard top-level documentation files (exclude from package)
^AGENTS\.md$
^CONSOLIDATION_.*\.md$
^PLAN_.*\.md$
^local_checks\.log$
^WIKI_.*\.md$
^.*_EXAMPLES\.md$
^DEVTOOLS_LOAD_ALL_EXAMPLES\.md$
^GC_ROOT_EXAMPLES\.md$
^TIPS\.txt$
^shinylive-sw\.js$
