^.*\.Rproj$
^\.Rproj\.user$
^\.github$
^_targets\.R$
^_targets$
^\.DS_Store$
^random_walk\.md$
^R/setup$
^R/plans$
^check_output\.log$
^default\.nix$
^_pkgdown\.yml$
^docs$
^pkgdown$
^archive$
^CLAUDE_CONTEXT\.md$
^PROJECT_INFO\.md$
^push_to_cachix\.sh$
^.*\.sh$
^rix_minimal\.nix$
^default-ci\.nix$
^default-dev\.nix$
^default\.R$
^package\.nix$
