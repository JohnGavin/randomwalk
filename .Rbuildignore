^result$
^result/$
^benchmarks$
^benchmarks/$
^_extensions$
^_extensions/
^vignettes/_extensions$
^vignettes/_extensions/
^_quarto\.yml$

# Ignore other hidden files/directories found by R CMD check at top level
^\.cachix_test$
^\.envrc_old$
^\.claude$
^\.claude/
^\.quarto$
^\.quarto/

# Exclude vignette build artifacts (keep source .qmd files)
^vignettes/.*\.html$
^vignettes/.*_files/
^vignettes/_targets\.yaml$
^vignettes/\.quarto$

# Exclude Shinylive articles (pkgdown only, not R vignettes)
^vignettes/articles$
^vignettes/articles/

# Exclude disabled vignettes (Issue #132)
^vignettes/.*\.qmd\.disabled$
^vignettes/.*\.qmd\.bak$
^vignettes/README_DISABLED\.md$

# Non-standard top-level documentation files (exclude from package)
^CLAUDE\.md$
^CHANGELOG\.md$
^DEPLOYMENT_TEST\.md$
^AGENTS\.md$
^CONSOLIDATION_.*\.md$
^PLAN_.*\.md$
^local_checks\.log$
^WIKI_.*\.md$
^.*_EXAMPLES\.md$
^DEVTOOLS_LOAD_ALL_EXAMPLES\.md$
^GC_ROOT_EXAMPLES\.md$
^TIPS\.txt$
^shinylive-sw\.js$
^issue_number\.rds$
^demos$
^demos/
^\.deploy-trigger$
^nix-shell-root$

