# Ignore Quarto/Shinylive generated files and directories within vignettes (source and built versions)
^vignettes/.*\.qmd$
^vignettes/.*\.html$
^vignettes/.*_files/$
^vignettes/.quarto/

# Ignore other hidden files/directories found by R CMD check at top level
^\.cachix_test$
^\.envrc_old$
^\.claude$
^\.claude/
^\.quarto$
^\.quarto/

# Specific ignore for shinylive/webr compiled objects and related files
^vignettes/.*/libs/quarto-contrib/shinylive-0.9.1/shinylive/webr/.*$
